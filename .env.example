# Configuration de l'application Horoscope Guadeloupéen

# ===========================================
# API Keys
# ===========================================
# Clé API pour Mistral AI (TTS et LLM)
MISTRAL_API_KEY=your_mistral_api_key

# Clé pour le chiffrement des emails
EMAIL_ENCRYPTION_KEY=your_32_char_encryption_key_here

# ===========================================
# Configuration Email (pour la newsletter)
# ===========================================
# Choose ONE of the following email providers:

## Option 1: SMTP (Gmail, OVH, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false  # true for port 465, false for others
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password  # For Gmail with 2FA: https://myaccount.google.com/apppasswords
EMAIL_FROM="Horoscope Guadeloupéen" <newsletter@horoscope-guadeloupe.com>

## Option 2: SendGrid (recommandé pour la production)
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM="Horoscope Guadeloupéen" <newsletter@horoscope-guadeloupe.com>

## Option 3: Mailchimp Transactional (anciennement Mandrill)
MAILCHIMP_API_KEY=your_mailchimp_api_key
EMAIL_FROM="Horoscope Guadeloupéen" <newsletter@horoscope-guadeloupe.com>

# ===========================================
# Configuration Next.js
# ===========================================
NODE_ENV=development

# ===========================================
# Configuration Netlify
# ===========================================
# Token pour vider le cache (API clear-tts-cache)
CLEAR_CACHE_TOKEN=your_clear_cache_token

# ===========================================
# Variables pour le déploiement
# ===========================================
# Domaine autorisé pour CORS
ALLOWED_ORIGINS=https://horoscope-guadeloupe.com,https://www.horoscope-guadeloupe.com

# ===========================================
# Instructions
# ===========================================
# 1. Copiez ce fichier en .env.local pour le développement
#    cp .env.example .env.local
#
# 2. Ne commitez JAMAIS vos fichiers .env* dans Git
#    Ils sont déjà dans .gitignore
#
# 3. Pour Gmail avec 2FA:
#    - Allez sur https://myaccount.google.com/apppasswords
#    - Générez un "App Password" pour "Mail"
#    - Utilisez ce mot de passe dans SMTP_PASS
#
# 4. Pour SendGrid:
#    - Créez un compte sur https://sendgrid.com
#    - Générez une API key dans Settings > API Keys
#    - Donnez-lui les permissions "Mail Send"
#
# 5. Pour Mailchimp Transactional:
#    - Créez un compte sur https://mailchimp.com
#    - Allez dans Settings > Extras > Transactional
#    - Générez une API key
